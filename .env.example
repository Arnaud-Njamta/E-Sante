# Serveur
PORT=3000
NODE_ENV=development

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=e_sante
DB_USER=root
DB_PASSWORD=
# DB_SYNC_ALTER=true  # uniquement en dev si besoin

# JWT — PRODUCTION : clé aléatoire ≥ 32 caractères (openssl rand -base64 48)
JWT_SECRET=change_me_generate_a_strong_secret_min_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS (origines séparées par des virgules)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Rate limiting (requêtes / 15 min)
RATE_LIMIT_GLOBAL=500
RATE_LIMIT_LOGIN=20
RATE_LIMIT_REGISTER=10
RATE_LIMIT_ORD_VERIFY=15
RATE_LIMIT_INSCRIPTION_STATUT=10

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DjamSanté <noreply@djamsante.cm>

# Production
# SEED_DEMO=false
# ENABLE_SWAGGER=false
# JITSI_DOMAIN=meet.votre-domaine.cm

# DPO / RGPD
DPO_EMAIL=dpo@djamsante.cm
DPO_PHONE=+237600000000
DPO_ADDRESS=Ministère de la Santé Publique, Yaoundé, Cameroun

# Commissions DjamSanté (décimal : 0.10 = 10 %)
COMMISSION_CONSULTATION_RATE=0.10
COMMISSION_PHARMACIE_RATE=0.05

# Paiement CinetPay (Mobile Money Cameroun) — laisser vide = mode simulation en dev
# CINETPAY_ENABLED=true
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_TRANSFER_ENABLED=true
# API_PUBLIC_URL=https://api.votre-domaine.cm

# API_PUBLIC_URL=https://api.votre-domaine.cm

# SMS / OTP (mock en dev — code fixe 123456, pas de SMS réel)
SMS_MODE=mock
SMS_MOCK_CODE=123456
SMS_OTP_REQUIRED=true
# SMS_OTP_TTL_MINUTES=10
# SMS_OTP_MAX_ATTEMPTS=5
# RATE_LIMIT_OTP=15
# Production Africa's Talking :
# SMS_MODE=live
# SMS_PROVIDER=africas_talking
# AFRICAS_TALKING_API_KEY=
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_SENDER_ID=DjamSante

# Rappels RDV par SMS (cron interne quotidien)
RDV_REMINDER_ENABLED=true
RDV_REMINDER_HOUR=8

# Intelligence artificielle (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
