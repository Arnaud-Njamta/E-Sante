# ─── Production DjamSanté — copier vers .env sur le VPS ───

NODE_ENV=production
PORT=3000

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=e_sante
DB_USER=medisante
DB_PASSWORD=CHANGER_MOT_DE_PASSE
DB_SYNC_ALTER=false
SEED_DEMO=false

# JWT — openssl rand -base64 48
JWT_SECRET=CHANGER_CLE_ALEATOIRE_MIN_48_CARACTERES
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# URLs publiques
FRONTEND_URL=https://djamsante.cm
CORS_ORIGINS=https://djamsante.cm
API_PUBLIC_URL=https://api.djamsante.cm

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email SMTP
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DjamSanté <noreply@djamsante.cm>

# Swagger désactivé en prod
ENABLE_SWAGGER=false

# Commissions
COMMISSION_CONSULTATION_RATE=0.10
COMMISSION_PHARMACIE_RATE=0.05

# CinetPay (paiements réels)
CINETPAY_ENABLED=true
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_TRANSFER_ENABLED=true

# SMS production
SMS_MODE=live
SMS_PROVIDER=africas_talking
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=DjamSante
SMS_OTP_REQUIRED=true

# Rappels RDV
RDV_REMINDER_ENABLED=true
RDV_REMINDER_HOUR=8

# IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Rate limiting
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_LOGIN=15
RATE_LIMIT_OTP=10

# DPO
DPO_EMAIL=dpo@djamsante.cm
DPO_PHONE=+237600000000
