# DjamSanté — configuration Nginx (exemple)
# Copier vers /etc/nginx/sites-available/medisante

# Frontend React (fichiers statiques)
server {
    listen 80;
    server_name djamsante.cm www.djamsante.cm;

    root /var/www/medisante-front;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

# API Backend (proxy vers Node.js)
server {
    listen 80;
    server_name api.djamsante.cm;

    client_max_body_size 12M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# Après installation : sudo certbot --nginx -d djamsante.cm -d www.djamsante.cm -d api.djamsante.cm
